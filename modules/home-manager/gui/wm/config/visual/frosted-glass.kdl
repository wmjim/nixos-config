// ============================================================
// 磨砂玻璃桌面 — 统一窗口规则（niri v26.04）
// ============================================================
//
// Noctalia Shell 的界面元素（启动器、控制中心、overview）使用 layer-shell，
// window-rule 对 layer-shell 无效，必须用 layer-rule 启用模糊。
// xray：让窗口背景透过下面的其它窗口层


// 全局：所有窗口声明启用模糊。
// 注意这本身不产生任何视觉效果——不透明窗口没有东西可以"透"。
// 实际生效的只有下面显式给了 opacity < 1 的窗口（foot / btop），
// 以及 Noctalia 的 layer 面（layer-rule 对本段 window-rule 无效，需单独声明）。
// 保留这条规则的意义：以后新增的半透明窗口不必重复声明 blur/xray。
window-rule {
    background-effect {
        blur true
        xray false
    }
}

// --- 终端模拟器：磨砂玻璃的黄金场景 ---
// btop 窗口由 foot 以 --app-id=btop 启动（见 binds/apps.kdl），单独列出
//
// opacity 取 0.85 而不是 0.70：这是「玻璃好看」与「文字可读」的取舍，而它是可
// 量化的。opacity 作用在**整个窗口**上（niri 文档：“applied to every surface of
// the window”），所以窗口背后永远是“0.7×底色 + 0.3×模糊后的壁纸”。
// foot / btop 的底色是 Frappe base #303446，主文字是 Frappe text #C6D0F5：
//
//     opacity   亮壁纸下的可见底色   对比度      判定
//       0.70    #6E717E             3.18:1   ⚠️ 低于 AA(4.5)
//       0.80    #595D6B             4.29:1   ⚠️ 仍差一点
//       0.85    #4F5262             5.06:1   ✅ AA
//       0.90    #454858             5.92:1   ✅
//
// “亮壁纸”取最坏情况纯白（模糊 + saturation 1.10 只会更亮）。桌面壁纸是经常
// 更换的自由变量（见 doc/themes.md 的壁纸一节），所以这里按最坏情况定值：
// 0.85 在纯白壁纸下仍达 AA，而暗壁纸下为 8.3:1，玻璃质感也还看得出来。
// 若想更透，代价是“壁纸必须是暗调”——那是个合理的设计立场，但得是有意选的。
window-rule {
    match app-id="^(foot|btop)$"
    opacity 0.85
    background-effect {
        blur true
        xray true
    }
}

// 模糊概览壁纸
layer-rule {
    match namespace="^noctalia-backdrop"
    place-within-backdrop true
}

/*
  Noctalia（夜境）
  为所有界面图层禁用透视效果，让视觉效果更贴合真实观感。
  当系统支持 ext-background-effects 协议时，Noctalia 会自动推送模糊区域数据。
*/
layer-rule {
  match namespace="^noctalia-(bar-[^\"]+|notification|dock|panel|attached-panel|osd)$"
  background-effect {
    xray false
    // blur false
  }
}
