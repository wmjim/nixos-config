// ============================================================
// 磨砂玻璃桌面 — 统一窗口规则（niri v26.04）
// ============================================================
//
// Noctalia Shell 的界面元素（启动器、控制中心、overview）使用 layer-shell，
// window-rule 对 layer-shell 无效，必须用 layer-rule 启用模糊。
// xray：让窗口背景透过下面的其它窗口层


// 全局：所有窗口声明启用模糊。
// 注意这本身不产生任何视觉效果——不透明窗口没有东西可以"透"。
// 实际生效的只有下面显式给了 opacity < 1 的窗口（foot / btop），
// 以及 Noctalia 的 layer 面（layer-rule 对本段 window-rule 无效，需单独声明）。
// 保留这条规则的意义：以后新增的半透明窗口不必重复声明 blur/xray。
window-rule {
    background-effect {
        blur true
        xray false
    }
}

// --- 终端模拟器：磨砂玻璃的黄金场景 ---
// btop 窗口由 foot 以 --app-id=btop 启动（见 binds/apps.kdl），单独列出
window-rule {
    match app-id="^(foot|btop)$"
    opacity 0.70
    background-effect {
        blur true
        xray true
    }
}

// 模糊概览壁纸
layer-rule {
    match namespace="^noctalia-backdrop"
    place-within-backdrop true
}

/*
  Noctalia（夜境）
  为所有界面图层禁用透视效果，让视觉效果更贴合真实观感。
  当系统支持 ext-background-effects 协议时，Noctalia 会自动推送模糊区域数据。
*/
layer-rule {
  match namespace="^noctalia-(bar-[^\"]+|notification|dock|panel|attached-panel|osd)$"
  background-effect {
    xray false
    // blur false
  }
}
