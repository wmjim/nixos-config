// 窗口规则
// 全局：默认平铺，圆角修饰
window-rule {
    // ── 圆角：对齐 macOS 的 concentricity 阶梯 ───────────────────────────────
    //
    // MacTahoe-Dark 在 gtk-4.0/gtk.css 里实现的档位（2026-10-01 对照代码核过）：
    //
    //     window.csd                 24   ← 窗口本身（= 下面取的值）
    //     floating/bottom-sheet       24   ← 独立浮动面板
    //     notebook.frame              19   ┐
    //     .sidebar-pane / .content-pane 18 ├ 嵌在窗口内（24−5 / 24−6）
    //     notebook > header           16   │
    //     notebook … tab              14   ┘
    //     popover / menu / osd        12   ← 独立弹层（含输入法候选窗，见下）
    //     按钮 / 输入框                 6
    //     药丸                      9999
    //
    // 注：输入法候选窗本属这一档，但它的圆角烘在上游 SVG 里（39×39, rx=8），
    // 由 fcitx5.nix 的 runCommand 改成 12、并把九宫格 Margin 从 10 抬到 14
    // （rx 必须 ≤ Margin，否则角片会被切）。
    //
    // 改这个值之前先读 docs/themes.md「圆角为何是 24px」：为何取主题自己的 24
    // 而不是字面的 macOS 16、内层为何不能比外层更圆、以及被 clip-to-geometry
    // 裁掉的 CSD 阴影由谁补上（现由合成器阴影提供，见 wm/default.nix）。
    geometry-corner-radius 24
    clip-to-geometry true
    draw-border-with-background false
    open-maximized false
    open-floating false            // 默认平铺
}

// 允许 Noctalia 执行通知操作和激活窗口
debug {
    honor-xdg-activation-with-invalid-serial
}

// ═══════════════════════════════════════════════
// 最大化窗口
// ═══════════════════════════════════════════════

// WinApps — Windows 虚拟机整机会话（FreeRDP RemoteApp）
//
// app-id 不是 freerdp / sdl-freerdp3，而是由 WinApps 启动整机会话时传给 FreeRDP 的
// /wm-class:"Microsoft Windows"（见上游 src/bin/winapps：整机会话用固定值
// "Microsoft Windows"，单应用 RemoteApp 用该应用全名）—— SDL3 客户端把 wm-class
// 直接当作 Wayland 的 app_id，故实测 app-id 就是 "Microsoft Windows"。
//
// 整机会话是一整套自带任务栏的远程桌面，按普通窗口半屏打开没有意义；该会话带
// +dynamic-resolution，最大化后远端会跟着改分辨率。
//
// 只匹配整机会话：单应用 RemoteApp 窗口的 wm-class 是各自应用全名（如
// "Microsoft Word"），不落在本规则内、仍按普通窗口平铺；若想让某个应用也
// 打开即最大化，按它的全名另加一条同款规则即可。
window-rule {
    match app-id="^Microsoft Windows$"
    open-maximized true
}

// VS Code — 主窗口（最大化）
window-rule {
    match app-id="(?i)^code"
    open-maximized true
}

// Logisim Evolution — 逻辑电路模拟
window-rule {
    match app-id="com-cburch-logisim-Main"
    open-maximized true
}

// brave — 浏览器
window-rule {
    match app-id="brave"
    open-maximized true
}

// Zotero — 文献管理
window-rule {
    match app-id="(?i)zotero"
    open-maximized true
}


// ═══════════════════════════════════════════════
// 浮动窗口（按用途分档，不逐个手调）
// ═══════════════════════════════════════════════
//
// 档位表（2026-10-01 定）：niri 的 kdl 没有变量，所以下面每条规则仍写具体数字，
// 但数字只允许取自这张表，规则行上注明所属档位。新增浮窗应用时先归到某一档，
// 不要新造数字 —— 此前 13 条规则用出 11 种几何（0.45 与 0.5、0.5 与 0.55 同屏
// 出现没有任何理由），档位就是为了消掉这种"看起来都差不多"的累积。
//
//     档位          宽     高      用途
//     sidebar      0.20   1.00    贴边的旁路工具（划词/翻译，满高度）
//     tool         0.30   0.40    看一眼就关（查词、便签、上传小面板）
//     chat         0.45   0.70    消息
//     transfer     0.50   0.60    传文件（要放设备列表/二维码）
//     settings     0.55   0.70    偏好面板
//     content      0.60   0.70    看图 / 看数字

// Fcitx5 配置 — 输入法设置 · settings
window-rule {
    match app-id="(?i)fcitx5"
    open-floating true
    default-column-width { proportion 0.55; }
    default-window-height { proportion 0.70; }
}

// PicGo — 图床上传工具 · tool
window-rule {
    match app-id="(?i)picgo"
    open-floating true
    default-column-width { proportion 0.30; }
    default-window-height { proportion 0.40; }
}

// btop++ — 终端系统监控 · content
window-rule {
    match app-id="(?i)btop"
    open-floating true
    default-column-width { proportion 0.60; }
    default-window-height { proportion 0.70; }
}

// qView — 图片查看器 · content
window-rule {
    match app-id="(?i)qview"
    open-floating true
    default-column-width { proportion 0.60; }
    default-window-height { proportion 0.70; }
}

// LocalSend — 局域网文件传输 · transfer
window-rule {
    match app-id="(?i)localsend"
    open-floating true
    default-column-width { proportion 0.50; }
    default-window-height { proportion 0.60; }
}

// 微信 / QQ / Telegram / Discord — 消息 · chat
// 四条同档，故尺寸相同（Discord 原为 0.5 宽，收进 chat）
window-rule {
    match app-id="(?i)wechat"
    open-floating true
    default-column-width { proportion 0.45; }
    default-window-height { proportion 0.70; }
}

window-rule {
    match app-id="(?i)^qq$"
    open-floating true
    default-column-width { proportion 0.45; }
    default-window-height { proportion 0.70; }
}

window-rule {
    match app-id="(?i)telegram"
    open-floating true
    default-column-width { proportion 0.45; }
    default-window-height { proportion 0.70; }
}

window-rule {
    match app-id="(?i)discord"
    open-floating true
    default-column-width { proportion 0.45; }
    default-window-height { proportion 0.70; }
}

// 欧陆词典 — 查词小窗 · tool
window-rule {
    match app-id="(?i)eudic"
    open-floating true
    default-column-width { proportion 0.30; }
    default-window-height { proportion 0.40; }
}

// gnome-text-editor — 便签 · tool
// （原为 0.20×0.10：4K 上约 512×144 逻辑像素，四行高，不是一个能用的尺寸）
window-rule {
    match app-id="(?i)gnome-text-editor"
    open-floating true
    default-column-width { proportion 0.30; }
    default-window-height { proportion 0.40; }
}

// ═══════════════════════════════════════════════
// 侧边浮动
// ═══════════════════════════════════════════════

// Pot — 划词翻译（右侧浮动长条，满高度）· sidebar
//
// 曾漏写 open-floating：全局规则已声明 open-floating false，而本规则只给了
// 尺寸和 default-floating-position —— 后者**只对浮动窗口生效**，于是查词窗
// 一直按平铺打开，把旁边的窗口挤走。查词/翻译是「临时看一眼」的旁路操作，
// 必须浮动覆盖在内容之上，不参与布局重排。
window-rule {
    match app-id="(?i)pot"
    open-floating true
    default-column-width { proportion 0.20; }
    default-window-height { proportion 1.00; }
    default-floating-position x=0 y=0 relative-to="top-right"
}

// Pot — 偏好设置面板（覆盖上面的通用规则）· settings
//
// open-floating 同样显式写出：设置面板必须浮动，不依赖上一条规则的继承
// （两条规则都命中同一窗口时，后者的 open-floating 会覆盖前者）。
window-rule {
    match app-id="(?i)pot" title="Config"
    open-floating true
    default-column-width { proportion 0.55; }
    default-window-height { proportion 0.70; }
}
