// 窗口规则
// 全局：默认平铺，圆角修饰
window-rule {
    // ── 圆角：对齐 macOS 的 concentricity 阶梯 ───────────────────────────────
    //
    // Apple 在 WWDC 2025 "Build an AppKit app with the new design" 里把新设计
    // 概括为 concentricity：每个内层元素的曲率都落在容器圆角之内，
    // 即 r_inner = r_outer − inset；且窗口圆角**随窗口样式变化**：
    // "Windows with toolbars now use a larger radius … Titlebar-only windows
    //   retain a smaller corner radius"。Tahoe 的标题栏型窗口默认为 16，
    // 带工具栏的更大；Sequoia（macOS 15）为 10。
    //
    // MacTahoe-Dark 在 gtk-4.0/gtk.css 里实现的正是这套阶梯，基准 24：
    //
    //     window.csd                 24   ← 窗口本身
    //     floating/bottom-sheet       24   ← 独立浮动面板
    //     notebook.frame              19   ┐
    //     .sidebar-pane / .content-pane 18 ├ 嵌在窗口内（24−5 / 24−6）
    //     notebook > header           16   │
    //     notebook … tab              14   ┘
    //     popover / menu / osd        12   ← 独立弹层
    //     按钮 / 输入框                 6
    //     药丸                      9999
    //
    // 取 24（= 主题自己的窗口基准）而不是字面的 16：内层元素是 18/19px，
    // 若把窗口压到 16，内层会比外层**更圆**，必须连带重写窗口 + 侧边栏 +
    // notebook + tab 共 5 个选择器，且主题更新后会静默失配。取 24 则零主题覆盖，
    // 而且 GTK 自绘（24）与不自绘圆角的应用（Electron / Chromium / X11：
    // VSCode、Discord、QQ、Telegram、Zotero、Typora、Anki、Steam）终于一致——
    // 那才是这整套圆角在修的正事。
    //
    // 代价（需用眼睛确认）：niri 的 clip-to-geometry 会裁掉 CSD 自绘阴影，
    // 半径越大裁掉的角越多（12px 时每角约 123 px²，24px 时约 494 px²）。
    // 若看出"阴影角被切"，两个出路：
    //   a) 打开 niri 的 shadow { on }，用合成器自己的阴影统一替代被裁掉的 CSD 阴影
    //   b) 改回字面 macOS 值 16，并按 concentricity 把上面 5 个选择器用
    //      gtk.gtk{3,4}.extraCss 一并下移 8px
    geometry-corner-radius 24
    clip-to-geometry true
    draw-border-with-background false
    open-maximized false
    open-floating false            // 默认平铺
}

// 允许 Noctalia 执行通知操作和激活窗口
debug {
    honor-xdg-activation-with-invalid-serial
}

// ═══════════════════════════════════════════════
// 最大化窗口
// ═══════════════════════════════════════════════

// VS Code — 主窗口（最大化）
window-rule {
    match app-id="(?i)^code"
    open-maximized true
}

// Logisim Evolution — 逻辑电路模拟
window-rule {
    match app-id="com-cburch-logisim-Main"
    open-maximized true
}

// brave — 浏览器
window-rule {
    match app-id="brave"
    open-maximized true
}

// Zotero — 文献管理
window-rule {
    match app-id="(?i)zotero"
    open-maximized true
}


// ═══════════════════════════════════════════════
// 浮动窗口（按应用性质设定合适比例）
// ═══════════════════════════════════════════════
// Fcitx5 配置 — 输入法设置
window-rule {
    match app-id="(?i)fcitx5"
    open-floating true
    default-column-width { proportion 0.5; }
    default-window-height { proportion 0.55; }
}

// PicGo — 图床上传工具
window-rule {
    match app-id="(?i)picgo"
    open-floating true
    default-column-width { proportion 0.35; }
    default-window-height { proportion 0.5; }
}

// btop++ — 终端系统监控
window-rule {
    match app-id="(?i)btop"
    open-floating true
    default-column-width { proportion 0.7; }
    default-window-height { proportion 0.7; }
}

// qView — 图片查看器
window-rule {
    match app-id="(?i)qview"
    open-floating true
    default-column-width { proportion 0.6; }
    default-window-height { proportion 0.7; }
}

// LocalSend — 局域网文件传输
window-rule {
    match app-id="(?i)localsend"
    open-floating true
    default-column-width { proportion 0.5; }
    default-window-height { proportion 0.6; }
}

// WeChat — 微信
window-rule {
    match app-id="(?i)wechat"
    open-floating true
    default-column-width { proportion 0.45; }
    default-window-height { proportion 0.7; }
}

// QQ
window-rule {
    match app-id="(?i)^qq$"
    open-floating true
    default-column-width { proportion 0.45; }
    default-window-height { proportion 0.7; }
}

// Telegram
window-rule {
    match app-id="(?i)telegram"
    open-floating true
    default-column-width { proportion 0.45; }
    default-window-height { proportion 0.7; }
}

// Discord
window-rule {
    match app-id="(?i)discord"
    open-floating true
    default-column-width { proportion 0.5; }
    default-window-height { proportion 0.7; }
}

// 欧陆词典 — 查词小窗
window-rule {
    match app-id="(?i)eudic"
    open-floating true
    default-column-width { proportion 0.3; }
    default-window-height { proportion 0.4; }
}

// gnome-text-editor
window-rule {
    match app-id="(?i)gnome-text-editor"
    open-floating true
    default-column-width { proportion 0.2; }
    default-window-height { proportion 0.1; }
}

// ═══════════════════════════════════════════════
// 侧边浮动
// ═══════════════════════════════════════════════

// Pot — 划词翻译（右侧浮动长条，满高度）
//
// 曾漏写 open-floating：全局规则已声明 open-floating false，而本规则只给了
// 尺寸和 default-floating-position —— 后者**只对浮动窗口生效**，于是查词窗
// 一直按平铺打开，把旁边的窗口挤走。查词/翻译是「临时看一眼」的旁路操作，
// 必须浮动覆盖在内容之上，不参与布局重排。
window-rule {
    match app-id="(?i)pot"
    open-floating true
    default-column-width { proportion 0.2; }
    default-window-height { proportion 1.0; }
    default-floating-position x=0 y=0 relative-to="top-right"
}

// Pot — 偏好设置面板（覆盖上面的通用规则）
//
// open-floating 同样显式写出：设置面板必须浮动，不依赖上一条规则的继承
// （两条规则都命中同一窗口时，后者的 open-floating 会覆盖前者）。
window-rule {
    match app-id="(?i)pot" title="Config"
    open-floating true
    default-column-width { proportion 0.55; }
    default-window-height { proportion 0.70; }
}
