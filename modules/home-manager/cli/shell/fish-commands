# NixOS 重建
sudo nixos-rebuild switch --flake ~/Projects/nixos-config#wsl     | 更新 WSL 系统
sudo nixos-rebuild switch --flake ~/Projects/nixos-config#laptop  | 更新 laptop 系统

# niri 相关
niri validate                                            | 解析 niri 配置文件并查看错误信息

# noctalia 快捷键速查（keymap 插件）
noctalia msg panel-toggle blackbartblues/keymap:panel              | 打开 keymap 插件快捷键查看面板
noctalia msg plugin blackbartblues/keymap:niri-service all refresh | 重新解析 niri 配置中的快捷键
noctalia msg plugins list                                          | 列出已安装的 noctalia 插件

# tmux 相关
tmux list-keys                                           | 查看tmux所有快捷键
tmux new -s <name>                                       | 新建命名会话
tmux ls                                                  | 列出所有会话
tmux attach -t <name>                                    | 附加到指定会话
tmux kill-session -t <name>                              | 关闭指定会话

# Git
git config --list                                        | 列出git当前所有配置
git reset --hard <commit_id>                             | 强制git仓库回退到某个历史提交
git revert <commit_id>                                   | 生成一个反向提交，抵消某次历史提交


# 系统
sensors                                                  | 查看CPU温度/风扇转速 


# yt-dlp 视频下载(cookies file in ~/.cookies)
# 单个视频下载
yt-dlp -f "bestvideo+bestaudio/best" --merge-output-format mp4 --cookies <cookies.txt> --embed-subs -o "%(title)s.%(ext)s" "<视频链接>"

# 播放列表下载
yt-dlp -f "bestvideo+bestaudio/best" --merge-output-format mp4 --cookies <cookies.txt> --embed-subs -o "%(playlist_title)s/%(playlist_index)s - %(title)s.%(ext)s" "<播放列表链接>"


# 显示器上电后塌成 640x480：期望看到"第 N 次重读后恢复"且桌面自己跳回 4K 
journalctl -u edid-reprobe -o short-iso | tail          | 显示器分辨率恢复